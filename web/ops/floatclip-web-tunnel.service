[Unit]
Description=FloatClip private node tunnel to existing Azure HTTPS ingress
After=network-online.target floatclip-web.service
Wants=network-online.target
Requires=floatclip-web.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -i /home/orangepi/.ssh/orangepi_key.pem -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o TCPKeepAlive=yes -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/home/orangepi/.ssh/known_hosts -R 127.0.0.1:18788:127.0.0.1:18391 DHSP@40.81.17.167
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
MemoryMax=64M

[Install]
WantedBy=default.target
