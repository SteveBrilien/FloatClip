<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui" xmlns:d="clr-namespace:FloatClip.Desktop.Design">
  <Style x:Key="FloatClip.Button.Default" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
    <Setter Property="FontFamily" Value="{DynamicResource FloatClip.FontFamily}"/><Setter Property="FontSize" Value="{DynamicResource FloatClip.Font.Body}"/>
    <Setter Property="MinHeight" Value="{DynamicResource FloatClip.Hit.Control}"/><Setter Property="Padding" Value="{DynamicResource FloatClip.Padding.Control}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource FloatClip.Radius.Control}"/>
    <Setter Property="Background" Value="{DynamicResource FloatClip.Surface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Border}"/><Setter Property="BorderThickness" Value="1"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Pressed}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Accent}"/></Trigger>
      <Trigger Property="d:DesignStates.IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Selected}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource FloatClip.DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.DisabledText}"/><Setter Property="Opacity" Value="{DynamicResource FloatClip.Opacity.Disabled}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FloatClip.Button.Default}"/>
  <Style x:Key="FloatClip.Button.Toolbar" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FloatClip.Button.Default}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="FloatClip.Button.Accent" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FloatClip.Button.Default}"><Setter Property="Appearance" Value="Primary"/><Setter Property="Background" Value="{DynamicResource FloatClip.Accent}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.OnAccent}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.AccentHover}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.OnAccent}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.AccentPressed}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.OnAccent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource FloatClip.DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.DisabledText}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FloatClip.Button.Danger" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FloatClip.Button.Toolbar}"><Setter Property="Foreground" Value="{DynamicResource FloatClip.Danger}"/></Style>
  <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource UiContextMenu}"><Setter Property="Background" Value="{DynamicResource FloatClip.Surface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Border}"/><Setter Property="FontFamily" Value="{DynamicResource FloatClip.FontFamily}"/></Style>
  <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource UiMenuItem}"><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="FontFamily" Value="{DynamicResource FloatClip.FontFamily}"/></Style>
  <Style x:Key="FloatClip.File.Row" TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="4,8"/><Setter Property="MinHeight" Value="{DynamicResource FloatClip.Row.File}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Selected}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource FloatClip.DisabledText}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FloatClip.File.Header" TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource FloatClip.Surface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextSecondary}"/>
    <Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Border}"/>
    <Setter Property="FontWeight" Value="Medium"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Pressed}"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
