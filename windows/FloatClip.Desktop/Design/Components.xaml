<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui" xmlns:d="clr-namespace:FloatClip.Desktop.Design">
  <Style x:Key="FloatClip.Button.Default" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
    <Setter Property="FontFamily" Value="{DynamicResource FloatClip.FontFamily}"/><Setter Property="FontSize" Value="{DynamicResource FloatClip.Font.Body}"/>
    <Setter Property="MinHeight" Value="{DynamicResource FloatClip.Hit.Control}"/><Setter Property="Padding" Value="{DynamicResource FloatClip.Padding.Control}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource FloatClip.Radius.Control}"/>
    <Setter Property="Background" Value="{DynamicResource FloatClip.Surface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Border}"/><Setter Property="BorderThickness" Value="1"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Pressed}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Accent}"/></Trigger>
      <Trigger Property="d:DesignStates.IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Selected}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="d:DesignStates.IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource FloatClip.SelectedHover}"/></MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource FloatClip.DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.DisabledText}"/><Setter Property="Opacity" Value="{DynamicResource FloatClip.Opacity.Disabled}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FloatClip.Button.Default}"/>
  <Style x:Key="FloatClip.Button.Toolbar" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FloatClip.Button.Default}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="FloatClip.Button.Accent" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FloatClip.Button.Default}"><Setter Property="Appearance" Value="Primary"/><Setter Property="Background" Value="{DynamicResource FloatClip.Accent}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.OnAccent}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.AccentHover}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.OnAccent}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.AccentPressed}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.OnAccent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource FloatClip.DisabledSurface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.DisabledText}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FloatClip.Button.Danger" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource FloatClip.Button.Toolbar}"><Setter Property="Foreground" Value="{DynamicResource FloatClip.Danger}"/></Style>
  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{DynamicResource FloatClip.Surface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Border}"/>
    <Setter Property="FontFamily" Value="{DynamicResource FloatClip.FontFamily}"/><Setter Property="FontSize" Value="{DynamicResource FloatClip.Font.Caption}"/><Setter Property="Padding" Value="{DynamicResource FloatClip.Padding.ToolTip}"/>
    <Setter Property="MaxWidth" Value="{DynamicResource FloatClip.ToolTip.MaxWidth}"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    <Setter Property="HasDropShadow" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource FloatClip.Radius.Control}" Padding="{TemplateBinding Padding}" RenderOptions.ClearTypeHint="Enabled"><TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource UiContextMenu}">
    <Setter Property="Background" Value="{DynamicResource FloatClip.Surface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Border}"/><Setter Property="FontFamily" Value="{DynamicResource FloatClip.FontFamily}"/><Setter Property="FontSize" Value="{DynamicResource FloatClip.Font.Body}"/><Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource FloatClip.Radius.Card}" Padding="{DynamicResource FloatClip.Padding.Popup}" RenderOptions.ClearTypeHint="Enabled"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource UiMenuItem}">
    <Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="FontFamily" Value="{DynamicResource FloatClip.FontFamily}"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="{DynamicResource FloatClip.Hit.Control}"/><Setter Property="Padding" Value="{DynamicResource FloatClip.Padding.Menu}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Grid>
      <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource FloatClip.Radius.Control}"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
        <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/>
        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
        <ui:SymbolIcon x:Name="Arrow" Grid.Column="2" Symbol="ChevronRight16" FontSize="{DynamicResource FloatClip.Icon.Small}" Visibility="Collapsed"/>
      </Grid></Border>
      <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="{DynamicResource FloatClip.Surface}" BorderBrush="{DynamicResource FloatClip.Border}" BorderThickness="1" CornerRadius="{DynamicResource FloatClip.Radius.Card}" Padding="{DynamicResource FloatClip.Padding.Popup}"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></Popup>
    </Grid><ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger>
      <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource FloatClip.DisabledText}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FloatClip.File.Row" TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource FloatClip.TextPrimary}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="{DynamicResource FloatClip.Padding.FileRow}"/><Setter Property="MinHeight" Value="{DynamicResource FloatClip.Row.File}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Selected}"/></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource FloatClip.SelectedHover}"/></MultiTrigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource FloatClip.DisabledText}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FloatClip.File.Header" TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource FloatClip.Surface}"/><Setter Property="Foreground" Value="{DynamicResource FloatClip.TextSecondary}"/>
    <Setter Property="Padding" Value="{DynamicResource FloatClip.Padding.FileHeader}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Border}"/>
    <Setter Property="FontWeight" Value="Medium"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewColumnHeader"><Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
      <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="{DynamicResource FloatClip.Space.8}" Background="Transparent" Cursor="SizeWE"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb>
    </Grid></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Pressed}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="FloatClip.Setting.Row" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource FloatClip.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource FloatClip.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource FloatClip.Radius.Card}"/><Setter Property="Padding" Value="{DynamicResource FloatClip.Padding.Card}"/><Setter Property="Margin" Value="0,0,0,4"/>
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource FloatClip.Hover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource FloatClip.DisabledSurface}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="FloatClip.ToggleSwitch" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}"><Setter Property="OnContent" Value=""/><Setter Property="OffContent" Value=""/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="MinHeight" Value="{DynamicResource FloatClip.Hit.Control}"/><Setter Property="MinWidth" Value="{DynamicResource FloatClip.Space.48}"/></Style>
  <Style x:Key="FloatClip.Setting.OptionRow" TargetType="Border" BasedOn="{StaticResource FloatClip.Setting.Row}">
    <Setter Property="Height" Value="{DynamicResource FloatClip.Device.OptionHeight}"/><Setter Property="Padding" Value="{DynamicResource FloatClip.Padding.OptionRow}"/>
  </Style>
</ResourceDictionary>
